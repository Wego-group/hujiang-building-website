# Google Search Console HTML-tag verification value (not the complete meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID, for example G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# WXPusher Simple Push Token. Used only for WeChat enquiry notifications; no email is sent.
WXPUSHER_SPT=

# Upstash Redis REST credentials used for short-lived daily traffic events.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional protection for the daily report endpoint. Vercel Cron supplies this header when configured.
CRON_SECRET=

# Canonical public URL used in the daily report.
PUBLIC_SITE_URL=https://www.chinamegasteel.com
